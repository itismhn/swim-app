# ---- Database (PostgreSQL) ----
# Replace USER with your local Postgres role. No password is needed for a default Homebrew install.
DATABASE_URL="postgresql://USER@localhost:5432/swim_dev?schema=public"
# Separate database used ONLY by integration tests (it is wiped on every run).
DATABASE_URL_TEST="postgresql://USER@localhost:5432/swim_test?schema=public"

# ---- Sessions ----
# Session lifetime in hours.
SESSION_TTL_HOURS=72

# ---- Seed data ----
# Password assigned to every SYNTHETIC demo account created by `npm run db:seed`.
# Change it; never reuse a real password.
SEED_DEMO_PASSWORD="change-me-demo-only"

# ---- External services (NOT CONFIGURED) ----
# The app sends no SMS or email until these are filled in AND an adapter is implemented
# in src/server/notify-external.ts. Notifications are in-app only today.
SMS_PROVIDER_API_KEY=""
SMS_SENDER_NUMBER=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
